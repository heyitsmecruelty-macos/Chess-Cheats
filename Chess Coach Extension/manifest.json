{
  "manifest_version": 3,
  "name": "Venice Chess Coach",
  "version": "2.4",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["https://*.chess.com/*", "https://*.lichess.org/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://*.chess.com/*", "https://*.lichess.org/*"], "js": ["coach.js"], "run_at": "document_idle" }
  ]
}